# Copy to .env and fill in, then `source .env` before running forge script.
# NEVER commit .env (it's already in .gitignore) or a real private key anywhere.

# Robinhood Chain Testnet — chain ID 46630, explorer at
# https://explorer.testnet.chain.robinhood.com, faucet at
# https://faucet.testnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com/rpc

# Robinhood Chain MAINNET — chain ID 4663, explorer at
# https://robinhoodchain.blockscout.com. Only used by DeployRBDXMainnet.s.sol.
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Deployer key. Testnet: use a throwaway wallet funded via the faucet above.
# Mainnet: whatever wallet is funding the deploy gas — this key has NO lasting
# admin power after deploy (DeployRBDXMainnet.s.sol renounces RBDXToken
# ownership and never grants this address any role), so it does not need to be
# treated as a long-term privileged key, just protect it during the deploy itself.
PRIVATE_KEY=

# Optional on testnet (defaults to the deployer address). REQUIRED on mainnet —
# DeployRBDXMainnet.s.sol has no default and reverts if unset, specifically so a
# real deploy can't silently ship with an EOA admin. Must be a multisig (e.g. a
# Safe) on mainnet, never a plain EOA — see docs/DESIGN.md section 6.
# ADMIN_ADDRESS=
# DEV_TREASURY=

# Optional: defaults to script/config/assets.testnet.json (or
# script/config/assets.mainnet.json for the mainnet script) if unset.
# ASSETS_CONFIG=

# Optional, only needed if you pass --verify to forge script (Blockscout on
# Robinhood Chain Testnet generally doesn't require a real API key).
# BLOCKSCOUT_API_KEY=
